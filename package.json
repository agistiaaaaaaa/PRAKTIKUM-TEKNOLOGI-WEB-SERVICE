{
  "name": "wisataku",
  "version": "2.0.0",
  "description": "Backend API WisataKu - NestJS, Prisma, MariaDB (Modul Praktikum Teknologi Web Service STMIK Lombok)",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build wisataku-api && nest build gateway && nest build service-destinasi && nest build service-reservasi",
    "build:api": "nest build wisataku-api",
    "build:gateway": "nest build gateway",
    "build:destinasi": "nest build service-destinasi",
    "build:reservasi": "nest build service-reservasi",
    "start:api": "nest start wisataku-api --watch",
    "start:gateway": "nest start gateway --watch",
    "start:destinasi": "nest start service-destinasi --watch",
    "start:reservasi": "nest start service-reservasi --watch",
    "start:prod:api": "node dist/wisataku-api/main",
    "start:prod:gateway": "node dist/gateway/main",
    "start:prod:destinasi": "node dist/service-destinasi/main",
    "start:prod:reservasi": "node dist/service-reservasi/main",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "openapi:export": "ts-node -r tsconfig-paths/register scripts/export-openapi.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "prettier --write \"{wisataku-api,gateway,service-destinasi,service-reservasi,libs,test,prisma,scripts}/**/*.ts\"",
    "test": "jest",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "roots": [
      "<rootDir>/libs",
      "<rootDir>/gateway",
      "<rootDir>/service-destinasi",
      "<rootDir>/service-reservasi",
      "<rootDir>/wisataku-api"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.spec.json"
        }
      ]
    },
    "maxWorkers": "50%",
    "collectCoverageFrom": [
      "**/*.ts",
      "!**/main.ts",
      "!**/*.module.ts"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@wisataku/common(|/.*)$": "<rootDir>/libs/common/src$1",
      "^@wisataku/auth(|/.*)$": "<rootDir>/libs/auth/src$1",
      "^@wisataku/domain(|/.*)$": "<rootDir>/libs/domain/src$1"
    }
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@nestjs/apollo": "^13.4.5",
    "@nestjs/common": "^11.2.6",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.6",
    "@nestjs/graphql": "^13.4.5",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/microservices": "^11.2.6",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.6",
    "@nestjs/swagger": "^11.4.7",
    "@prisma/client": "^6.19.3",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "graphql": "^16.14.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.6",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.4",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.2.1",
    "jest": "^29.7.0",
    "prettier": "^3.9.9",
    "prisma": "^6.19.3",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.14",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "yaml": "^2.9.1"
  }
}
