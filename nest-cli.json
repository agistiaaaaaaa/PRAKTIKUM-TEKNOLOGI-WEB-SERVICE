{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "monorepo": true,
  "root": "wisataku-api",
  "sourceRoot": "wisataku-api/src",
  "compilerOptions": {
    "webpack": true,
    "deleteOutDir": true,
    "tsConfigPath": "wisataku-api/tsconfig.app.json"
  },
  "projects": {
    "wisataku-api": {
      "type": "application",
      "root": "wisataku-api",
      "entryFile": "main",
      "sourceRoot": "wisataku-api/src",
      "compilerOptions": { "tsConfigPath": "wisataku-api/tsconfig.app.json" }
    },
    "gateway": {
      "type": "application",
      "root": "gateway",
      "entryFile": "main",
      "sourceRoot": "gateway/src",
      "compilerOptions": { "tsConfigPath": "gateway/tsconfig.app.json" }
    },
    "service-destinasi": {
      "type": "application",
      "root": "service-destinasi",
      "entryFile": "main",
      "sourceRoot": "service-destinasi/src",
      "compilerOptions": { "tsConfigPath": "service-destinasi/tsconfig.app.json" }
    },
    "service-reservasi": {
      "type": "application",
      "root": "service-reservasi",
      "entryFile": "main",
      "sourceRoot": "service-reservasi/src",
      "compilerOptions": { "tsConfigPath": "service-reservasi/tsconfig.app.json" }
    },
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common/src",
      "compilerOptions": { "tsConfigPath": "libs/common/tsconfig.lib.json" }
    },
    "auth": {
      "type": "library",
      "root": "libs/auth",
      "entryFile": "index",
      "sourceRoot": "libs/auth/src",
      "compilerOptions": { "tsConfigPath": "libs/auth/tsconfig.lib.json" }
    },
    "domain": {
      "type": "library",
      "root": "libs/domain",
      "entryFile": "index",
      "sourceRoot": "libs/domain/src",
      "compilerOptions": { "tsConfigPath": "libs/domain/tsconfig.lib.json" }
    }
  }
}
