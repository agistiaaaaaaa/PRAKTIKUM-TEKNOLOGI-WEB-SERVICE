# Salin file ini menjadi .env lalu sesuaikan nilainya.
# File .env tidak boleh di-commit.

# ---------- Database ----------
# Lokal: arahkan ke MariaDB di mesin sendiri.
# Docker Compose menimpa nilai ini dengan host "mariadb".
DATABASE_URL="mysql://wisataku_user:wisataku_pass@localhost:3306/wisataku_db"

# ---------- JWT ----------
# Wajib diisi. Gunakan string acak panjang, contoh: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Masa berlaku token dalam detik (3600 = 1 jam)
JWT_EXPIRES_IN=3600

# ---------- Aplikasi monolitik (wisataku-api, Tugas 3-4) ----------
API_PORT=3000

# ---------- API Gateway (Tugas 5-6) ----------
GATEWAY_PORT=3000
SERVICE_DESTINASI_HOST=localhost
SERVICE_DESTINASI_PORT=5001
SERVICE_RESERVASI_HOST=localhost
SERVICE_RESERVASI_PORT=5002
# Batas waktu (ms) gateway menunggu balasan microservice
RPC_TIMEOUT_MS=5000

# ---------- Seed data (npm run db:seed) ----------
SEED_ADMIN_EMAIL=admin@wisataku.id
# Bungkus dengan tanda kutip bila mengandung karakter #, contoh: "Rahasia#123"
SEED_ADMIN_PASSWORD=

# ---------- Docker Compose (MariaDB container) ----------
# docker-compose.yml menyusun DATABASE_URL dari nilai di bawah, sehingga
# MARIADB_PASSWORD sebaiknya hanya berisi huruf dan angka (tanpa @ : / #).
MARIADB_ROOT_PASSWORD=
MARIADB_DATABASE=wisataku_db
MARIADB_USER=wisataku_user
MARIADB_PASSWORD=wisataku_pass
